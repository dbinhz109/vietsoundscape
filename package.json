{
  "name": "vietsoundscape",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Ban do am thanh Viet Nam - nen tang web thu thap, mo phong va bao ton soundscape",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "process": "node scripts/process-audio.mjs",
    "validate": "node scripts/validate-data.mjs",
    "survey": "node scripts/survey-archives.mjs",
    "check:recorder": "node scripts/check-recorder.mjs",
    "gen:audio": "python3 scripts/gen_test_audio.py",
    "spike": "node scripts/serve.mjs",
    "experiment": "node scripts/experiment-plan.mjs",
    "render:stimuli": "node scripts/render-stimuli.mjs",
    "analyse": "node scripts/analyse-results.mjs",
    "plan:sample": "node scripts/plan-sample.mjs",
    "demo": "PUBLIC_BASE=/vietsoundscape/ vite build && PUBLIC_BASE=/vietsoundscape/ vite preview --port 4173 --strictPort"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.11.1",
    "topojson-client": "^3.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
